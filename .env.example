# Agency API key — create in your portal admin (API Keys → agency-scoped key with the
# Reports capability, read + write). Used by BOTH the MCP connection (.mcp.json) and
# the sync script. Never commit .env.
REPORTING_SUITE_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Your portal's MCP endpoint (ends in /mcp) — used by .mcp.json.
REPORTING_SUITE_MCP_URL=https://api.your-portal.example/mcp
