config {
  type: "table",
  // Layer is in the NAME, not the schema — omit `schema` to inherit defaultDataset (the client
  // dataset). The staging_ prefix is what marks this a staging table.
  name: "staging_ad_spend",
  description: "One row per platform per ad per day: ad spend typed, cleaned and unioned to a common shape across Meta and Google. Additive — sum `spend` freely.",
  tags: ["staging", "marketing"],
  // Built-in assertions run after the build. A duplicated key here is the classic silent
  // fan-out that doubles a number three joins downstream — catch it at the boundary.
  assertions: {
    uniqueKey: ["platform", "ad_id", "day"],
    nonNull: ["platform", "ad_id", "day", "spend"],
  }
}

-- ${ref()} the declared raw sources — never the literal table name. Store spend as an additive
-- NUMERIC; rates (CPC, ROAS) are derived at read time from totals, never stored per-row.
WITH meta AS (
  SELECT
    DATE(date_start)                          AS day,
    CAST(ad_id AS STRING)                     AS ad_id,
    'meta'                                    AS platform,
    SAFE_CAST(spend AS NUMERIC)               AS spend
  FROM ${ref("raw_meta_ads_ads_insights")}
),
google AS (
  SELECT
    DATE(segments_date)                       AS day,
    CAST(campaign_id AS STRING)               AS ad_id,
    'google'                                  AS platform,
    SAFE_CAST(metrics_cost_micros AS NUMERIC) / 1e6 AS spend
  FROM ${ref("raw_google_ads_campaign_stats")}
)
SELECT * FROM meta
UNION ALL
SELECT * FROM google
