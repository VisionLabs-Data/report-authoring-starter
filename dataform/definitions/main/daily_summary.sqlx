config {
  type: "table",
  name: "daily_summary",
  description: "One row per day: whole-account ad performance with Meta and Google split out and a blended total. Reporting-ready. Spend/impressions/clicks are additive; blended_ctr / blended_cpc are ratios of the day's totals — don't average them across days.",
  tags: ["main", "marketing"],
  bigquery: { partitionBy: "summary_date" },
  assertions: {
    uniqueKey: ["summary_date"],
    nonNull: ["summary_date"]
  }
}

-- Roll the ad grain up to the account/day. Keeping platform totals in their OWN columns (rather than
-- one long table) is what lets a scorecard show "Meta vs Google spend" without a second query — it
-- mirrors main.daily_summary in the reference client.
SELECT
  report_date AS summary_date,
  SUM(IF(platform = 'meta',   spend,       0)) AS meta_ad_spend,
  SUM(IF(platform = 'meta',   impressions, 0)) AS meta_impressions,
  SUM(IF(platform = 'meta',   clicks,      0)) AS meta_clicks,
  SUM(IF(platform = 'meta',   link_clicks, 0)) AS meta_link_clicks,
  SUM(IF(platform = 'google', spend,       0)) AS google_ad_spend,
  SUM(IF(platform = 'google', impressions, 0)) AS google_impressions,
  SUM(IF(platform = 'google', clicks,      0)) AS google_clicks,
  SUM(spend)       AS total_ad_spend,
  SUM(impressions) AS total_impressions,
  SUM(clicks)      AS total_clicks,
  SUM(link_clicks) AS total_link_clicks,
  SAFE_DIVIDE(SUM(clicks), SUM(impressions)) AS blended_ctr,
  SAFE_DIVIDE(SUM(spend),  SUM(clicks))      AS blended_cpc
FROM ${ref("ads_daily_grain")}
GROUP BY summary_date
