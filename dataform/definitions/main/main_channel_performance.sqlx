config {
  type: "table",
  name: "main_channel_performance",
  // Reports query main_* directly, and the portal's AI reads this description when answering
  // questions about the data — so STATE THE GRAIN and flag any non-summable measure.
  description: "One row per channel per day. Ad spend aggregated by platform. Reporting-ready — a report can query this table directly. `spend` is additive; compute CPC / ROAS at read time as ratio-of-totals, never store a per-row rate.",
  tags: ["main", "marketing"],
  assertions: {
    uniqueKey: ["channel", "day"],
    nonNull: ["channel", "day"]
  }
}

-- Reads the modelled staging table, not raw_. If a report needs something only raw_ has, that's
-- a gap in THIS pipeline — add the model, don't re-derive it in the report's own SQL (or two
-- dashboards will answer the same question differently and nobody will notice).
SELECT
  platform    AS channel,
  day,
  SUM(spend)  AS spend
FROM ${ref("staging_ad_spend")}
GROUP BY channel, day
